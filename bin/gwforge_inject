#!/usr/bin/env python
"""
Inject gravitational wave signals into a network of detectors and save metadata.

Usage:
    gwforge_inject --config-file path/to/config.ini --data-directory path/to/data
"""
import os
import configparser
import argparse
import logging
import json
import h5py
import numpy
import copy
from gwpy.timeseries import TimeSeries
from GWForge.conversion import get_safe_signal_durations
from GWForge import utils
import warnings

warnings.filterwarnings("ignore", message="ERFA function*")

logging.basicConfig(
    level=logging.INFO, format="%(asctime)s %(message)s", datefmt="%Y-%m-%d %H:%M:%S"
)

# Load configurations
config = configparser.ConfigParser()
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--config-file", required=True, help="Path to the configuration ini file"
)
parser.add_argument("--data-directory", help="Parent directory containing frame files")
parser.add_argument(
    "--gps-start-time",
    type=float,
    default=None,
    help="GPS start time of data (default: None) (float seconds)",
)
parser.add_argument(
    "--gps-end-time",
    type=float,
    default=None,
    help="GPS end time of data (default: None) (float seconds)",
)
opts = parser.parse_args()
config.read(opts.config_file)

# Extract configuration settings
detectors = json.loads(config.get("IFOS", "detectors").replace("'", '"'))
network = copy.deepcopy(detectors)
logging.info("Initialising detector network with ifos {}".format(network))

# Handling ET as three separate detectors
if "ET" in detectors:
    index = detectors.index("ET")
    detectors.pop(index)
    detectors.extend(["ET1", "ET2", "ET3"])

try:
    data_directory = config.get("IFOS", "data-directory")
except Exception:
    data_directory = opts.data_directory

if config.has_option("IFOS", "channel-dict"):
    channels = json.loads(config.get("IFOS", "channel-dict").replace("'", '"'))
    channels = utils.update_ET_channels(channel_dict=channels)
else:
    logging.info("No channel-dict given; reading the <IFO>:INJ channels gwforge_noise writes")
    channels = {ifo: "{}:INJ".format(ifo) for ifo in detectors}

minimum_frequency = config.getfloat(
    "Injections", "waveform-minimum-frequency", fallback=3
)

# Log information about frame files and injections
logging.info("Loading injections")
injection_file = config.get("Injections", "injection-file")

injection_type = utils.source_type(config.get("Injections", "injection-type", fallback="bbh"))

waveform_approximant = config.get("Injections", "waveform-approximant")

from pycbc.waveform import fd_approximants, td_approximants

if waveform_approximant in td_approximants() + fd_approximants():
    logging.info(f"Using {waveform_approximant} for waveform generation")
else:
    import sys

    logging.error(f"{waveform_approximant} does not exist")
    sys.exit(1)

# The command line wins over the ini: the workflow runs one job per chunk with
# the same ini and different --gps-* values.
gps_start_time = opts.gps_start_time if opts.gps_start_time is not None else config.getfloat("Injections", "gps-start-time", fallback=None)
gps_end_time = opts.gps_end_time if opts.gps_end_time is not None else config.getfloat("Injections", "gps-end-time", fallback=None)

injection_method = config.get(
    "Injections", "injection-method", fallback="bilby"
).lower()
if injection_method == "pycbc":
    # SimAddInjection adds only the samples that overlap the data, so a signal is
    # truncated at the segment edges rather than wrapped, and the whole request
    # is one window: no 2- or 3-file rule, and no file before the start time.
    # ponytail: the span is held in memory (0.5 GB per detector per 8192 s at
    # 8192 Hz); chunk the window if that bites.
    window_size = 1

# Detector-response options (bilby injection method only; the pycbc method uses
# LAL's own projection). Both default to True: XG detectors see hour-long
# signals during which the Earth turns, and CE's free spectral range sits inside
# the analysis band, so neither approximation is safe there.
earth_rotation = config.getboolean("Injections", "earth-rotation", fallback=True)
finite_size = config.getboolean("Injections", "finite-size", fallback=True)

if gps_start_time is None or gps_end_time is None:
    raise ValueError(
        "Both gps-start-time and gps-end-time are required. Provide them in the "
        "[Injections] section of the config file or via --gps-start-time / "
        "--gps-end-time. (The injection loop indexes signals by geocent_time within "
        "this interval and cannot run without it.)"
    )
logging.info(
    "Considering frame files between {} and {}s".format(gps_start_time, gps_end_time)
)
safety = 4096

# The spins were drawn at the population's reference frequency; keep it.
with h5py.File(injection_file, "r") as f:
    reference_frequency = float(f["reference_frequency"][0]) if "reference_frequency" in f else minimum_frequency
    aligned_spins = not numpy.any(f["spin_1x"][:])
    if injection_method == "bilby":
        longest = numpy.max(
            get_safe_signal_durations(
                mass_1=f["mass_1"][:], mass_2=f["mass_2"][:], spin_1z=f["spin_1z"][:], spin_2z=f["spin_2z"][:],
                waveform_minimum_frequency=minimum_frequency, approximant=waveform_approximant,
            )
        )
        # The bilby method builds each signal over a window of consecutive files
        # and wraps anything longer than the window, so size the window from
        # the longest signal rather than from a 2-or-3-file rule.
        window_size = int(numpy.ceil(longest / safety)) + 1
        logging.info("Longest signal is %.0f s; the bilby method uses %d-file windows", longest, window_size)

waveform_arguments = {
    "reference_frequency": reference_frequency,
    "minimum_frequency": minimum_frequency,
    "waveform_approximant": waveform_approximant,
}

# Generate frame file sublists
frame_files = {}
for ifo in detectors:
    _, file_paths = utils.find_frame_files(
        directory=data_directory,
        filePattern="{}*h5".format(ifo),
        # to tackle signal across frame files
        start_time=gps_start_time - (window_size - 1) * safety,
        end_time=gps_end_time,
    )
    # is there a better way?
    sorted_file_paths = sorted(file_paths, key=lambda x: int(x.split("-")[-2]))
    frame_files[ifo] = (
        [sorted_file_paths]
        if injection_method == "pycbc"
        else utils.generate_frame_file_sublists(sorted_file_paths, window_size=window_size)
    )
    if not frame_files[ifo]:
        raise ValueError(
            "{}: the bilby method needs {} consecutive frame files for the longest signal but found {}; "
            "generate data before the start time or use injection-method = pycbc".format(ifo, window_size, len(sorted_file_paths))
        )

# Directories for each detector
ifo_directory = {}
for ifo in detectors:
    ifo_directory[ifo] = os.path.join(data_directory, ifo)


# Configure samples dictionary for storing results
parameters = [
    "mass_1",
    "mass_2",
    "luminosity_distance",
    "theta_jn",
    "phase",
    "ra",
    "dec",
    "psi",
    "geocent_time",
]

# Read signal parameters from the injection file
with h5py.File(injection_file, "r") as f:
    if injection_method == "bilby":
        if aligned_spins:
            logging.info("Provided injection data set is quasi-circular")
            parameters.extend(["chi_1", "chi_2"])
        else:
            logging.info("Provided injection data set is quasi-spherical")
            parameters.extend(["a_1", "a_2", "tilt_1", "tilt_2", "phi_12", "phi_jl"])
        if injection_type in ("bns", "bhns"):
            tides = [key for key in ("lambda_1", "lambda_2") if key in f]
            parameters.extend(tides)
            logging.info("Tidal deformabilities in the file: {}".format(tides or "none; injecting point particles"))
        samples = {}
        logging.info("Injecting signals using Bilby inject method")
        for param in parameters:
            samples[param] = []
        for ifo in detectors:
            samples["{}_optimal_snr".format(ifo)] = []
            samples["{}_matched_filter_snr".format(ifo)] = []

        from GWForge.inject.bilby_inject import BilbyInject

        k, l = 0, 0
        read = True
        # `ifos` only becomes defined once the first signal has been injected. Keep a
        # sentinel so the "save open frames" paths below don't hit an unbound name if
        # the first in-range signal falls outside the current data segment.
        ifos = None
        while l < len(frame_files[detectors[0]]) and k < len(f["geocent_time"]):
            if gps_start_time < f["geocent_time"][k] < gps_end_time:
                injection_parameters = {key: f[key][k] for key in parameters}
                if injection_type in ("bns", "bhns") and "lambda_2" in injection_parameters:
                    # The black hole in a BHNS has no tidal deformability.
                    injection_parameters.setdefault("lambda_1", 0.0)
                if read:
                    # Read the frame files only when necessary. Too memory intensive to load all of them at a time
                    logging.info("Reading network data")
                    data = {
                        ifo: TimeSeries.read(
                            frame_files[ifo][l], channels[ifo], nproc=window_size
                        )
                        for ifo in detectors
                    }

                # Check whether the injection lies within the data segment or not. If yes inject if no read a fresh set of frame files
                if (
                    (data[detectors[0]].epoch.value)
                    < injection_parameters["geocent_time"]
                    < (
                        data[detectors[0]].epoch.value
                        + data[detectors[0]].duration.value
                    )
                ):
                    read = False
                    logging.info("Injecting signal {} in the network".format(k))
                    ifos = BilbyInject(
                        ifos=network,
                        data=data,
                        injection_parameters=injection_parameters,
                        waveform_arguments=waveform_arguments,
                        injection_type=injection_type,
                        earth_rotation=earth_rotation,
                        finite_size=finite_size,
                    ).inject_signal_using_bilby_method()

                    # Update the data after injecting
                    for ifo in ifos:
                        data[ifo.name] = TimeSeries(
                            data=ifo.time_domain_strain,
                            times=ifo.time_array,
                            name=f"{ifo.name}:INJ",
                            channel=f"{ifo.name}:INJ",
                        )
                    # Record injection parameters and SNR values
                    for param in parameters:
                        samples[param].append(injection_parameters[param])

                    for ifo in ifos:
                        samples["{}_optimal_snr".format(ifo.name)].append(
                            ifos.meta_data[ifo.name]["optimal_SNR"]
                        )
                        samples["{}_matched_filter_snr".format(ifo.name)].append(
                            ifos.meta_data[ifo.name]["matched_filter_SNR"]
                        )

                else:
                    if ifos is not None:
                        for ifo in ifos:
                            utils.save_frame_files(
                                ifo=ifo,
                                start_time=ifo.start_time,
                                duration=utils.split_duration(ifo.duration),
                                ifo_directory=ifo_directory[ifo.name],
                            )
                    read = True
                    l += 1
                    continue
                    # Read the next set of frame files. Save the ones that are open

            elif f["geocent_time"][k] > gps_end_time:
                logging.info("Signal is outside the current data segment. Breaking")
                break

            k = k + 1
        # Save whatever window is still open: the loop ends by running out of
        # signals or of frame files as well as by passing the end time.
        if ifos is not None:
            for ifo in ifos:
                utils.save_frame_files(
                    ifo=ifo,
                    start_time=ifo.start_time,
                    duration=utils.split_duration(ifo.duration),
                    ifo_directory=ifo_directory[ifo.name],
                )
        # Save meta data to an HDF5 file
        logging.info("Saving meta data")
        meta_data_file = os.path.join(
            data_directory, f"injections-{injection_type}-{int(gps_start_time)}.h5"
        )
        with h5py.File(meta_data_file, "w") as f:
            for key in samples.keys():
                utils.hdf_append(f, key, samples[key])

    else:
        logging.info("Injecting signals using PyCBC inject method")
        from GWForge.inject.pycbc_inject import PyCBCInject
        from pycbc.fft.backend_support import set_backend

        scheme = config.get("IFOS", "fft-scheme", fallback="numpy")
        set_backend([scheme])
        injection_parameters = {}
        l = 0
        for param in parameters:
            try:
                injection_parameters[utils.pycbc_labels[param]] = None
            except Exception:
                continue
        if aligned_spins:
            logging.info("Provided injection data set is quasi-circular")
            for spin in ["spin_1z", "spin_2z"]:
                injection_parameters[utils.pycbc_labels[spin]] = None
        else:
            logging.info("Provided injection data set is quasi-spherical")
            for spin in [
                "spin_1x",
                "spin_2x",
                "spin_1y",
                "spin_2y",
                "spin_1z",
                "spin_2z",
            ]:
                injection_parameters[utils.pycbc_labels[spin]] = None
        recorded = {}
        start = gps_start_time
        while l < len(frame_files[detectors[0]]):
            # Read the frame files only when necessary. Too memory intensive to load all of them at a time
            logging.info("Reading network data")
            try:
                data = {
                    ifo: TimeSeries.read(
                        frame_files[ifo][l], channels[ifo], nproc=window_size
                    )
                    for ifo in detectors
                }
                read = False
                # Select every signal that overlaps the data: it merges inside
                # the segment, or after it with the inspiral already in band.
                end = data[detectors[0]].epoch.value + data[detectors[0]].duration.value
                merger_time = f["geocent_time"][:]
                signal_duration = numpy.atleast_1d(
                    get_safe_signal_durations(
                        mass_1=f["mass_1"][:],
                        mass_2=f["mass_2"][:],
                        spin_1z=f["spin_1z"][:],
                        spin_2z=f["spin_2z"][:],
                        waveform_minimum_frequency=minimum_frequency,
                        approximant=waveform_approximant,
                    )
                )
                indices = numpy.where(
                    (start <= merger_time) & (merger_time - signal_duration <= end)
                )
                logging.info(
                    "{} signals overlap the data between {} and {}".format(len(indices[0]), start, end)
                )
                # # set the start to end for next iteration
                start = end
                for key, value in utils.pycbc_labels.items():
                    try:
                        injection_parameters[value] = f[key][indices]
                    except Exception:
                        continue
                ifos = PyCBCInject(
                    ifos=network,
                    data=data,
                    injection_parameters=injection_parameters,
                    waveform_arguments=waveform_arguments,
                ).inject_signal_using_pycbc_method()
                for ifo in ifos:
                    utils.save_frame_files(
                        ifo=ifo,
                        start_time=ifo.start_time,
                        duration=utils.split_duration(ifo.duration),
                        ifo_directory=ifo_directory[ifo.name],
                    )
                for key, value in injection_parameters.items():
                    recorded.setdefault(key, []).append(numpy.atleast_1d(value))
                l += 1
            except Exception:
                logging.exception("Injection into window {} failed; skipping it".format(l))
                l += 1

        logging.info("Saving meta data")
        meta_data_file = os.path.join(
            data_directory, f"injections-{injection_type}-{int(gps_start_time)}.h5"
        )
        with h5py.File(meta_data_file, "w") as f:
            for key, values in recorded.items():
                utils.hdf_append(f, key, numpy.concatenate(values))
logging.info("Done!")
