#!/usr/bin/env python
"""
Compute the optimal snr for every injection in a given HDF file
and store the results in an H5 File
"""
import numpy
import logging
import bilby
import h5py
import argparse
import json
from multiprocessing import Pool
from functools import partial
from rich.progress import track
import pandas as pd
from GWForge.conversion import get_safe_signal_durations
from GWForge.ifo.detectors import Network
from GWForge.ifo.antenna import inject_signal_with_response
from GWForge.utils import hdf_append


def coalescence_time(injection_parameters):
    """The coalescence GPS time of one injection.

    ``gwforge_population`` writes ``geocent_time``; older files (and
    ``GWForge.inject.pycbc_inject``) call the same quantity ``tc``. Accept
    either, preferring the current name.

    Parameters
    ----------
    injection_parameters : dict or pandas.Series

    Returns
    -------
    float

    Raises
    ------
    KeyError
        If neither name is present.
    """
    for name in ("geocent_time", "tc"):
        if name in injection_parameters:
            return injection_parameters[name]
    raise KeyError(
        "Injection has neither 'geocent_time' nor 'tc'; cannot place the signal."
    )


def get_optimal_snr(
    injection_parameters,
    parameters,
    detectors,
    waveform_arguments,
    sampling_frequency=8192,
    earth_rotation=True,
    finite_size=True,
    psd_files=None,
):
    bilby.core.utils.setup_logger(log_level="warning")
    ifos = Network(ifos=detectors, psd_files=psd_files).initialise_ifos()
    duration = numpy.ceil(injection_parameters["duration"] + 5)
    merger_time = coalescence_time(injection_parameters)
    gps_start_time = merger_time - duration
    ifos.set_strain_data_from_power_spectral_densities(
        sampling_frequency=sampling_frequency,
        duration=duration,
        start_time=gps_start_time,
    )

    waveform_generator = bilby.gw.WaveformGenerator(
        duration=duration,
        sampling_frequency=sampling_frequency,
        frequency_domain_source_model=bilby.gw.source.lal_binary_black_hole,
        parameter_conversion=bilby.gw.conversion.convert_to_lal_binary_black_hole_parameters,
        waveform_arguments=waveform_arguments,
    )
    signal_parameters = {}
    for parameter in parameters:
        signal_parameters[parameter] = injection_parameters[parameter]
    signal_parameters["geocent_time"] = merger_time
    # bilby's inject_signal hard-codes the long-wavelength, static-pattern
    # response; use GWForge's frequency-dependent one instead.
    inject_signal_with_response(
        ifos,
        waveform_generator=waveform_generator,
        parameters=signal_parameters,
        earth_rotation=earth_rotation,
        finite_size=finite_size,
    )
    for ifo in ifos:
        signal_parameters["{}_optimal_snr".format(ifo.name)] = ifo.meta_data[
            "optimal_SNR"
        ]
    # Added after the injection, not before, so the waveform generator never
    # sees it: this is bookkeeping, letting the SNR file be joined back to the
    # injection file by row rather than by assumed ordering.
    signal_parameters["index"] = injection_parameters["index"]
    return signal_parameters


def multiprocess(
    parameters,
    detectors,
    waveform_arguments,
    sampling_frequency,
    chunk,
    earth_rotation=True,
    finite_size=True,
    psd_files=None,
):
    results_list = []
    for idx, row in chunk.iterrows():
        meta_data = get_optimal_snr(
            injection_parameters=row,
            parameters=parameters,
            detectors=detectors,
            waveform_arguments=waveform_arguments,
            sampling_frequency=sampling_frequency,
            earth_rotation=earth_rotation,
            finite_size=finite_size,
            psd_files=psd_files,
        )
        results_list.append(meta_data)
    return results_list


def main():
    # Setting up logging configuration
    logging.basicConfig(
        level=logging.INFO, format="%(asctime)s %(message)s", datefmt="%Y-%m-%d %H:%M:%S"
    )

    parser = argparse.ArgumentParser(description=__doc__)

    # Define command-line arguments
    parser.add_argument(
        "--ifos",
        nargs="+",
        default=["CE40", "CE20", "ET"],
        help="List of detectors/observatories (space separated, e.g. --ifos CE40 CE20 ET)",
    )
    parser.add_argument(
        "--injection-file",
        type=str,
        required=True,
        help="Path to the HDF file containing injection parameters",
    )
    parser.add_argument(
        "--start-index",
        type=int,
        default=0,
        help="Index to start processing injections from",
    )
    parser.add_argument(
        "--end-index", type=int, default=None, help="Index to end processing injections at"
    )
    parser.add_argument(
        "--output-file",
        type=str,
        required=True,
        help="Path to the output H5 file to store results",
    )
    parser.add_argument(
        "--waveform-approximant",
        type=str,
        default="IMRPhenomXPHM",
        help="Waveform approximant for the signal",
    )
    parser.add_argument(
        "--minimum-frequency",
        type=float,
        default=7.0,
        help="Minimum frequency for the waveform",
    )
    parser.add_argument(
        "--sampling-frequency",
        type=float,
        default=8192,
        help="Sampling frequency of the strain the SNR is computed on. The "
        "cost of the whole pass is linear in this, and 2048 Hz already covers "
        "the ringdown of every stellar-mass binary, so lower it for large "
        "catalogues",
    )
    parser.add_argument(
        "--psd-dict",
        default=None,
        help="Override the noise curve of one or more detectors, as a "
        "single-quoted dict of detector name to ASD or PSD file, e.g. "
        "\"{'H1': 'aplus.txt', 'L1': 'aplus.txt'}\". The file type is "
        "detected from the magnitude of the array, so ASDs and PSDs are both "
        "accepted. Note this sets the *noise curve* only: the integration band "
        "still comes from the interferometer's own minimum_frequency and "
        "maximum_frequency, which --minimum-frequency does not change",
    )
    parser.add_argument(
        "--cores",
        type=int,
        default=10,
        help="Number of CPU cores to use for parallel processing",
    )
    parser.add_argument(
        "--no-earth-rotation",
        action="store_true",
        help="Freeze the antenna pattern at the coalescence time instead of "
        "evolving it along the signal (restores the historical behaviour)",
    )
    parser.add_argument(
        "--no-finite-size",
        action="store_true",
        help="Use the long-wavelength approximation for the detector response "
        "instead of the per-arm transfer function (restores the historical "
        "behaviour)",
    )

    opts = parser.parse_args()

    waveform_arguments = {
        "waveform_approximant": opts.waveform_approximant,
        "reference_frequency": opts.minimum_frequency,
        "minimum_frequency": opts.minimum_frequency,
    }

    psd_files = None
    if opts.psd_dict:
        try:
            psd_files = json.loads(opts.psd_dict.replace("'", '"'))
        except json.JSONDecodeError as error:
            raise ValueError(
                "Could not parse --psd-dict {!r}; expected a dict such as "
                "\"{{'H1': 'aplus.txt'}}\"".format(opts.psd_dict)
            ) from error
        missing = [name for name in psd_files if name not in opts.ifos]
        if missing:
            raise ValueError(
                "--psd-dict names {} which are not in --ifos {}. The override "
                "would be silently ignored.".format(missing, opts.ifos)
            )
        logging.info(
            "Overriding noise curves: %s",
            ", ".join("{} -> {}".format(k, v) for k, v in psd_files.items()),
        )
        psd_files = {name: psd_files.get(name) for name in opts.ifos}

    detectors = opts.ifos
    logging.info("Reading injections")
    samples = {}
    with h5py.File(opts.injection_file, "r") as f:
        for key in f.keys():
            # gwforge_population --save-config writes a 'config' *group*, which
            # is not a per-injection array; skip anything that is not a dataset.
            if not isinstance(f[key], h5py.Dataset):
                continue
            if len(f[key]) != 1:
                samples[key] = f[key][:]
        if len(f["spin_1x"][:]) != 1:
            parameters = [
                "mass_1",
                "mass_2",
                "phase",
                "phi_12",
                "phi_jl",
                "ra",
                "dec",
                "theta_jn",
                "tilt_1",
                "tilt_2",
                "luminosity_distance",
                "psi",
                "a_1",
                "a_2",
            ]
        else:
            parameters = [
                "mass_1",
                "mass_2",
                "phase",
                "ra",
                "dec",
                "theta_jn",
                "luminosity_distance",
                "psi",
                "chi_1",
                "chi_2",
            ]
        if not opts.end_index:
            opts.end_index = len(f["mass_1"])

    logging.info("Calculating safe signal duration")
    samples["duration"] = get_safe_signal_durations(
        mass_1=samples["mass_1"],
        mass_2=samples["mass_2"],
        spin_1z=samples["spin_1z"],
        spin_2z=samples["spin_2z"],
        waveform_minimum_frequency=waveform_arguments["minimum_frequency"],
    )

    # Row index into the injection file, carried through to the output.
    samples["index"] = numpy.arange(len(samples["mass_1"]))

    samples = pd.DataFrame.from_dict(samples)
    sub = samples.iloc[opts.start_index : opts.end_index]
    # Split the DataFrame into bits and pieces. Split the *positions* rather than the
    # frame: numpy.array_split stopped preserving DataFrames at numpy 2.3 /
    # pandas 3.0 and hands back bare ndarrays, which have no .iterrows().
    chunks = [
        sub.iloc[positions]
        for positions in numpy.array_split(numpy.arange(len(sub)), opts.cores)
    ]
    logging.info("Calculating optimal snr")
    with Pool(processes=opts.cores) as pool:
        partial_multiprocess = partial(
            multiprocess,
            parameters,
            detectors,
            waveform_arguments,
            opts.sampling_frequency,
            earth_rotation=not opts.no_earth_rotation,
            finite_size=not opts.no_finite_size,
            psd_files=psd_files,
        )
        results_list = list(
            track(
                pool.imap(partial_multiprocess, chunks),
                total=len(chunks),
                description="Processing chunks",
            )
        )

    if "ET" in detectors:
        detectors.remove("ET")
        detectors.extend(["ET1", "ET2", "ET3"])

    parameters.append("index")
    for ifo in detectors:
        parameters.append("{}_optimal_snr".format(ifo))
    samples = {}
    for parameter in parameters:
        samples[parameter] = []

    logging.info("Saving results")
    for results in results_list:
        for parameter in parameters:
            for k in range(len(results)):
                samples[parameter].append(results[k][parameter])

    with h5py.File(opts.output_file, "w") as f:
        for key in samples.keys():
            hdf_append(f, key, samples[key])
    logging.info("Done!")


if __name__ == "__main__":
    main()
